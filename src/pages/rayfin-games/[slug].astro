---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { rayfinGames, IFRAME_ALLOW, type RayFinGame } from '../../data/rayfin-games';

export function getStaticPaths() {
  return rayfinGames.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

interface Props { game: RayFinGame }
const { game } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const allow = [...IFRAME_ALLOW, ...(game.extraAllow ?? [])].join('; ');
const newWindowLabel = game.newWindowLabel ?? `Open ${game.title} in new window (camera)`;
const others = rayfinGames.filter((g) => g.slug !== game.slug);
---

<BaseLayout title={`Play ${game.title} | RayFin Games | PowerBI.tips`} description={game.description} fullWidth={true}>
  <div class="mx-auto w-full max-w-7xl">
    <div class="rf-player" data-rf-player>
      <div class:list={['rf-player__bar', { 'rf-player__bar--cam': game.needsCamera }]}>
        <a class="rf-player__btn" href={`${base}/rayfin-games/`} aria-label="Back to all RayFin games">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span>All games</span>
        </a>
        <h1 class="rf-player__title">{game.title}</h1>
        {game.needsCamera && (
          <a class="rf-player__newwin" href={game.url} target="_blank" rel="noopener" data-rf-newwin>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>{newWindowLabel}</span>
          </a>
        )}
        <div class="rf-player__actions">
          <button type="button" class="rf-player__btn" data-rf-fullscreen aria-label="Play full screen">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span>Full screen</span>
          </button>
          <a class="rf-player__btn rf-player__btn--icon" href={`${base}/rayfin-games/`} aria-label="Close game">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>
          </a>
        </div>
      </div>
      <div class="rf-player__frame">
        <iframe
          src={game.url}
          title={`${game.title} game`}
          allow={allow}
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </div>

    {game.needsCamera && (
      <p class="mt-3 max-w-3xl rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900" data-rf-camera-hint>
        Camera works only in the new window. Use the "{newWindowLabel}" button above to play with your camera.
      </p>
    )}

    <p class="mt-4 max-w-3xl text-neutral-600">{game.description}</p>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-neutral-900">More RayFin games</h2>
      <ul class="mt-4 grid gap-4 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
        {others.map((g) => (
          <li>
            <a href={`${base}/rayfin-games/${g.slug}/`} class="block overflow-hidden rounded-xl border border-neutral-200 transition hover:-translate-y-1 hover:shadow-md">
              <img src={`${base}/images/rayfin-games/${g.slug}.webp`} alt={`${g.title} screenshot`} width="960" height="540" loading="lazy" decoding="async" class="aspect-[16/9] w-full object-cover" />
              <div class="p-3 text-sm font-semibold text-neutral-900">{g.title}</div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .rf-player { display: flex; flex-direction: column; overflow: hidden; border-radius: 1rem; background: #0b1024; box-shadow: 0 20px 50px rgba(11, 16, 36, .25); }
  .rf-player__bar { display: flex; align-items: center; gap: .75rem; padding: .6rem .75rem; color: #fff; background: linear-gradient(90deg, #3b82f6, #8b5cf6); }
  .rf-player__title { flex: 1; min-width: 0; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 1.05rem; font-weight: 600; text-align: center; }
  .rf-player__actions { display: flex; gap: .5rem; }
  .rf-player__btn { display: inline-flex; align-items: center; gap: .4rem; min-height: 40px; padding: .4rem .8rem; border: 0; border-radius: 999px; cursor: pointer;
    font: inherit; font-size: .875rem; font-weight: 600; color: #fff; text-decoration: none; background: rgba(255, 255, 255, .16); transition: background .15s ease; }
  .rf-player__btn:hover { background: rgba(255, 255, 255, .28); }
  .rf-player__btn:focus-visible { outline: 3px solid #ffd719; outline-offset: 2px; }
  .rf-player__btn svg { width: 18px; height: 18px; flex: 0 0 auto; }
  .rf-player__btn--icon { padding: .4rem; width: 40px; justify-content: center; }
  .rf-player__frame { position: relative; width: 100%; height: min(78vh, 56.25vw + 120px); min-height: 420px; background: #000; }
  .rf-player__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }
  .rf-player__bar--cam { display: grid; grid-template-columns: 1fr auto 1fr; }
  .rf-player__bar--cam > :first-child { justify-self: start; }
  .rf-player__bar--cam .rf-player__actions { justify-self: end; }
  .rf-player__bar--cam .rf-player__title { display: none; }
  .rf-player__newwin { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; padding: .5rem 1.1rem; border-radius: 999px; font-size: .95rem; font-weight: 700; color: #1a1033; text-decoration: none; text-align: center; background: #ffd719; box-shadow: 0 2px 10px rgba(0, 0, 0, .25); transition: transform .15s ease, background .15s ease; }
  .rf-player__newwin:hover { background: #ffe35c; transform: translateY(-1px); }
  .rf-player__newwin:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
  .rf-player__newwin svg { width: 18px; height: 18px; flex: 0 0 auto; }
  .rf-player:fullscreen { border-radius: 0; width: 100vw; height: 100vh; }
  .rf-player:fullscreen .rf-player__frame { flex: 1; height: auto; min-height: 0; }
  @media (max-width: 640px) {
    .rf-player__bar--cam { grid-template-columns: auto 1fr auto; row-gap: .5rem; }
    .rf-player__bar--cam .rf-player__newwin { grid-row: 2; grid-column: 1 / -1; justify-content: center; font-size: .85rem; padding: .5rem .8rem; }
    .rf-player__bar--cam ~ .rf-player__frame { height: calc(100svh - 200px); }
    .rf-player__newwin span { display: inline; }
    .rf-player__btn span { display: none; }
    .rf-player__btn { padding: .4rem; width: 40px; justify-content: center; }
    .rf-player__frame { height: calc(100svh - 150px); }
  }
</style>

<script>
  for (const player of document.querySelectorAll<HTMLElement>('[data-rf-player]')) {
    const btn = player.querySelector<HTMLButtonElement>('[data-rf-fullscreen]');
    if (!btn) continue;
    if (!document.fullscreenEnabled) { btn.hidden = true; continue; }
    btn.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else player.requestFullscreen().catch(() => {});
    });
  }
</script>
