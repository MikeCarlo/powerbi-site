---
import { getCollection, render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';
import { extractFaqItems, extractHowToSteps } from '../utils/schema-helpers';
import { isPodcastEpisode } from '../utils/podcast-episode';

function cleanSlug(id: string): string {
  return id.replace(/\/index\.mdx?$/, '').replace(/\.mdx?$/, '');
}

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  // Page path comes from the file path under src/content/blog (via entry id),
  // never from a frontmatter slug. Keep this inline — Astro extracts
  // getStaticPaths and cannot see helpers defined in this module.
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\/index\.mdx?$/, '').replace(/\.mdx?$/, '') },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Extract FAQ and HowTo structured data from raw markdown body
const rawBody = post.body || '';
// Episode pages take FAQ only from voiced frontmatter `faq`; parsing their
// section headings produced junk FAQPage data. Everything else (including
// Podcast-category posts that are not episodes) keeps body extraction.
const isEpisode = isPodcastEpisode(post.data.title, post.data.categories || [], rawBody);
const faqItems = isEpisode
  ? (post.data.faq ?? []).map(({ q, a }) => ({ question: q.endsWith('?') ? q : `${q}?`, answer: a }))
  : extractFaqItems(rawBody);
const headingSlugs = headings.map((heading) => heading.slug);
const howToSteps = extractHowToSteps(rawBody, post.data.categories || []);

const allPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((entry) => ({
    ...entry,
    slug: cleanSlug(entry.id)
  }));

const currentIndex = allPosts.findIndex((entry) => entry.id === post.id);
const prev = currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const next = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const morePosts = allPosts.filter((entry) => entry.id !== post.id).slice(0, 3);
---

<BlogPost entry={post} prev={prev} next={next} morePosts={morePosts} faqItems={faqItems} howToSteps={howToSteps} isEpisode={isEpisode} headingSlugs={headingSlugs}>
  <Content />
</BlogPost>
