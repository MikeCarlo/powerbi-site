---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { extractFaqItems } from '../utils/schema-helpers';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog');
const fabricPosts = allPosts
  .filter((post) => {
    const title = (post.data.title || '').toLowerCase();
    const excerpt = (post.data.excerpt || '').toLowerCase();
    const tags = (post.data.tags || []).map((t) => String(t).toLowerCase());
    const cats = (post.data.categories || []).map((c) => String(c).toLowerCase());
    return (
      tags.includes('fabric') ||
      tags.includes('microsoft-fabric') ||
      title.includes('fabric') ||
      excerpt.includes('fabric') ||
      cats.some((c) => c.includes('fabric'))
    );
  })
  .map((post) => {
    const slug = post.id.replace(/\/index\.mdx?$/, '').replace(/\.mdx?$/, '');
    return { ...post, slug };
  })
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 12);

const patterns = [
  {
    title: 'Build a Fabric-first semantic model',
    desc: 'Create governed models that scale across reports and apps (and keep performance predictable).',
    href: `${base}/microsoft-fabric/`,
  },
  {
    title: 'Power BI for the front-end experience',
    desc: 'Use Power BI as the reporting surface inside Fabric-enabled solutions.',
    href: `${base}/power-bi/`,
  },
  {
    title: 'Embedded analytics for product experiences',
    desc: 'Ship analytics in portals and apps with Power BI Embedded + Databricks AI/BI dashboards.',
    href: `${base}/power-bi-embedded/`,
  },
  {
    title: 'Podcast-driven learning',
    desc: 'Stay current with Fabric updates and real-world adoption stories.',
    href: `${base}/podcast/`,
  },
];
// Owned H2 + TL;DR + five FAQ H3s (Aero Batch 8 lock, Marko voice). extractFaqItems reads
// this string for FAQPage JSON-LD; the visible FAQ below renders from the same items.
const faqMarkdown = `## What are Fabric Apps, and when should a Power BI team build one?

**TL;DR.** Fabric Apps (preview) are TypeScript web apps on the Rayfin SDK, deployed to a Fabric workspace with SQL database, Entra ID sign-in, and hosting managed for you. Use one for writeback or custom interactions; keep KPI reporting in Power BI.

### How does a Fabric App work?

You define data models as TypeScript classes with decorators such as \`@entity()\`, \`@text()\`, and \`@uuid()\`, and Fabric Apps generates the database schema and GraphQL endpoints (Microsoft Learn). Running \`npx rayfin up\` creates the Fabric Apps item in your workspace with a SQL database in Fabric, Microsoft Entra ID single sign-on, and static hosting for the frontend.

### What is Rayfin?

Rayfin is the SDK that Fabric Apps is built on (Microsoft Learn, Rayfin SDK overview). It is decorator-driven, so you describe the schema once in TypeScript and get GraphQL APIs and type-safe clients. The Rayfin CLI scaffolds a project, runs it locally, and deploys it to Fabric.

### When is a Fabric App a better fit than a Power BI report?

In Explicit Measures Ep.563, Kurt Buhler points to control of every pixel, custom interactions, and integrations such as planning, writeback, or managing something that already lives in Fabric. The episode leaves the month-to-date sales report and the executive KPI page in Power BI until the design system, permission model, and token bill are real. Microsoft Learn lists prototypes, internal tools, data exploration, and AI agent backends as good fits, and complex multi-step transactions or custom auth providers as poor fits.

### Can people outside my tenant use a Fabric App?

Deployed apps sign users in with Microsoft Entra ID single sign-on (Microsoft Learn). For a public write such as a contact form, a tenant admin can enable anonymous data access, which Ep.555 calls an authorization option, not a replacement for authentication. Put the anonymous role on that one public table and keep everything else on a signed-in role. Agentic Thinking Ep.34 tries it live with a public intake form.

### Where can I watch Fabric Apps being built?

On Explicit Measures, watch Ep.547: The Hype of Rayfin, Ep.554: Fabric as a Backend, Ep.555: Anonymous Rayfin Fabric Apps, and Ep.563: Fabric Apps Fit into the PBI World. On Agentic Thinking, the sister show from PowerBI.tips, watch Ep.19: Rayfin, Ep.20: Rayfin Build, Ep.22: Fabric App - Rayfin Templates Build, Ep.23: Fabric Apps Rayfin, Ep.25: Replit and Fabric Apps Rayfin, Ep.34: Fabric SQL w Anonymous Access, and Ep.43: Rayfin Hot new Features.
`;

const faqItems = extractFaqItems(faqMarkdown);
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
const [ownedFaq, ...faqRest] = faqItems;

const fabricAppsLinks = [
  { label: "The Hype of Rayfin - Ep.547", href: "/2026/07/21/the-hype-of-rayfin-ep-547/" },
  { label: "Fabric as a Backend - Ep.554", href: "/2026/08/13/fabric-as-a-backend-ep-554/" },
  { label: "Anonymous Rayfin Fabric Apps - Ep.555", href: "/2026/08/18/anonymous-rayfin-fabric-apps-ep-555/" },
  { label: "Fabric Apps Fit into the PBI World - Ep.563", href: "/2026/09/15/fabric-apps-fit-into-the-pbi-world-ep-563/" },
  { label: "Agentic Thinking Ep.19: Rayfin", href: "https://agenticthinking.show/episodes/ep019-rayfin/" },
  { label: "Agentic Thinking Ep.20: Rayfin Build", href: "https://agenticthinking.show/episodes/ep020-rayfin-build/" },
  { label: "Agentic Thinking Ep.22: Fabric App - Rayfin Templates Build", href: "https://agenticthinking.show/episodes/ep022-fabric-app-rayfin-templates-build/" },
  { label: "Agentic Thinking Ep.23: Fabric Apps Rayfin", href: "https://agenticthinking.show/episodes/ep023-fabric-apps-rayfin/" },
  { label: "Agentic Thinking Ep.25: Replit and Fabric Apps Rayfin", href: "https://agenticthinking.show/episodes/ep025-replit-and-fabric-apps-rayfin/" },
  { label: "Agentic Thinking Ep.34: Fabric SQL w Anonymous Access", href: "https://agenticthinking.show/episodes/ep034-fabric-sql-w-anonymous-access/" },
  { label: "Agentic Thinking Ep.43: Rayfin Hot new Features", href: "https://agenticthinking.show/episodes/ep043-rayfin-hot-new-features/" },
  { label: "What is Fabric Apps (Preview)? - Microsoft Learn", href: "https://learn.microsoft.com/en-us/fabric/apps/overview" },
];
---

<BaseLayout
  title="Fabric Apps (Rayfin) for Power BI teams | PowerBI.tips"
  description="What are Fabric Apps, and when should a Power BI team build one?"
  jsonLd={faqJsonLd}
>
  <section class="mb-10">
    <h1 class="text-4xl font-semibold tracking-tight text-neutral-900">Fabric Apps</h1>
    <p class="mt-3 max-w-3xl text-lg text-neutral-600">
      Fabric is more than a data platform — it’s the foundation for building modern analytics applications.
      This page is the hub for how we think about <strong>Fabric apps</strong>, patterns that work, and the best content to learn fast.
    </p>

    <div class="mt-5 flex flex-wrap gap-3">
      <a class="rounded-full bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-blue-700" href={`${base}/microsoft-fabric/`}>Explore Microsoft Fabric</a>
      <a class="rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-neutral-800" href={`${base}/podcast/`}>Listen to the Podcast</a>
      <a class="rounded-full bg-neutral-100 px-5 py-2.5 text-sm font-semibold text-neutral-900 hover:bg-neutral-200" href={`${base}/search/?q=fabric`}>Search “fabric”</a>
    </div>
  </section>

  <section class="mb-12 prose max-w-none">
    <h2>{ownedFaq.question}</h2>
    <p><strong>TL;DR.</strong> {ownedFaq.answer.replace(/^TL;DR\.\s*/, '')}</p>
    {faqRest.map((item) => (
      <>
        <h3>{item.question}</h3>
        <p>{item.answer}</p>
      </>
    ))}
    <h3 class="not-prose mt-8 text-lg font-semibold text-neutral-900">Watch and read</h3>
    <ul>
      {fabricAppsLinks.map((link) => (
        <li>
          {link.href.startsWith('/') ? (
            <a href={`${base}${link.href}`}>{link.label}</a>
          ) : (
            <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="grid gap-6 md:grid-cols-2">
    <div class="rounded-2xl border border-neutral-200 p-6">
      <h2 class="text-2xl font-semibold text-neutral-900">Start with Fabric fundamentals</h2>
      <p class="mt-2 text-neutral-600">
        New to Fabric? Start with the Fabric hub and the Fabric-heavy podcast episodes.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a class="rounded-full bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" href={`${base}/microsoft-fabric/`}>Microsoft Fabric</a>
        <a class="rounded-full bg-neutral-100 px-4 py-2 text-sm font-semibold text-neutral-900 hover:bg-neutral-200" href={`${base}/podcast/`}>Podcast</a>
      </div>
    </div>

    <div class="rounded-2xl border border-neutral-200 p-6">
      <h2 class="text-2xl font-semibold text-neutral-900">Power BI inside Fabric apps</h2>
      <p class="mt-2 text-neutral-600">
        Many Fabric apps still rely on Power BI for semantic models, reporting, and embedded experiences.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a class="rounded-full bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-800" href={`${base}/power-bi/`}>Power BI</a>
        <a class="rounded-full bg-neutral-100 px-4 py-2 text-sm font-semibold text-neutral-900 hover:bg-neutral-200" href={`${base}/power-bi-embedded/`}>Power BI Embedded</a>
      </div>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-semibold text-neutral-900">Patterns for building Fabric apps</h2>
    <p class="mt-2 text-neutral-600 max-w-3xl">
      A few practical paths we see working repeatedly for teams adopting Fabric.
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {patterns.map((p) => (
        <a href={p.href} class="block rounded-xl border border-neutral-200 p-5 hover:shadow-md transition">
          <div class="font-semibold text-neutral-900">{p.title}</div>
          <div class="mt-2 text-sm text-neutral-600">{p.desc}</div>
          <div class="mt-3 text-sm font-semibold text-blue-600">Learn more →</div>
        </a>
      ))}
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-semibold text-neutral-900">Recent Fabric-related posts</h2>
    <p class="mt-2 text-neutral-600 max-w-3xl">
      A rolling set of posts and podcast write-ups that mention Fabric.
    </p>

    {fabricPosts.length ? (
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {fabricPosts.map((post) => (
          <a href={`${base}/${post.slug}/`} class="block overflow-hidden rounded-xl border border-neutral-200 hover:shadow-md transition">
            {post.data.featuredImage ? (
              <div class="aspect-[16/9] w-full bg-neutral-100">
                <Image
                  src={post.data.featuredImage}
                  alt={post.data.title}
                  class="h-full w-full object-cover"
                  widths={[400, 800]}
                  sizes="(max-width: 1024px) 100vw, 400px"
                />
              </div>
            ) : null}
            <div class="p-4">
              <div class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </div>
              <div class="mt-2 font-semibold text-neutral-900">{post.data.title}</div>
              {post.data.excerpt ? <div class="mt-2 text-sm text-neutral-600">{post.data.excerpt}</div> : null}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="mt-4 text-neutral-500">No Fabric-related posts found yet (based on tag/title/excerpt matching).</p>
    )}
  </section>
</BaseLayout>
