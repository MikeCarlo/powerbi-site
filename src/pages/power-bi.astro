---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog');

function slugOf(post) {
  return post.id.replace(/\/index\.mdx?$/, '').replace(/\.mdx?$/, '');
}

function matchesAny(post, needles) {
  const title = (post.data.title || '').toLowerCase();
  const excerpt = (post.data.excerpt || '').toLowerCase();
  const tags = (post.data.tags || []).map((t) => String(t).toLowerCase());
  const cats = (post.data.categories || []).map((c) => String(c).toLowerCase());

  return needles.some((n) => {
    const k = n.toLowerCase();
    return title.includes(k) || excerpt.includes(k) || tags.includes(k) || cats.some((c) => c.includes(k));
  });
}

function toCard(post) {
  return {
    title: post.data.title,
    date: post.data.date,
    excerpt: post.data.excerpt,
    featuredImage: post.data.featuredImage,
    href: `${base}/${slugOf(post)}/`,
  };
}

const themePosts = allPosts
  .filter((p) => matchesAny(p, ['theme', 'themes', 'power designer', 'gallery']))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6)
  .map(toCard);

const scrimPosts = allPosts
  .filter((p) => matchesAny(p, ['scrim', 'scrims']))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6)
  .map(toCard);

const layoutPosts = allPosts
  .filter((p) => matchesAny(p, ['layout', 'layouts', 'wireframe', 'template']))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6)
  .map(toCard);

const tipsPlusPosts = allPosts
  .filter((p) => matchesAny(p, ['tips+', 'tips plus', 'tips plus themes subscription']))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6)
  .map(toCard);
---

<BaseLayout
  title="Power BI Resources, Tools, Themes & Training | PowerBI.tips"
  description="PowerBI.tips is a leading resource for Power BI: the world’s longest-running Theme Generator, Tips+ tooling, free report layouts & scrims, and practical posts to build stunning reports."
>
  <section class="mb-10">
    <h1 class="text-4xl font-semibold tracking-tight text-neutral-900">Power BI</h1>
    <p class="mt-3 max-w-3xl text-lg text-neutral-600">
      PowerBI.tips helps you build better Power BI reports faster — with the world’s longest-running Theme Generator,
      Tips+ tooling, and a huge library of practical posts.
    </p>
  </section>

  <section class="grid gap-6 md:grid-cols-2">
    <div class="rounded-2xl border border-neutral-200 p-6">
      <h2 class="text-2xl font-semibold text-neutral-900">Theme generation</h2>
      <p class="mt-2 text-neutral-600">
        Create consistent, branded reports with the <strong>world’s most used and longest running Theme Generator</strong>.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a class="rounded-full bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" href="https://themes.powerbi.tips" target="_blank" rel="noopener noreferrer">Open Theme Generator</a>
        <a class="rounded-full bg-neutral-100 px-4 py-2 text-sm font-semibold text-neutral-900 hover:bg-neutral-200" href={`${base}/power-designer/`}>Power Designer</a>
      </div>
    </div>

    <div class="rounded-2xl border border-neutral-200 p-6">
      <h2 class="text-2xl font-semibold text-neutral-900">Tips+ (Fabric tooling for report builders)</h2>
      <p class="mt-2 text-neutral-600">
        Use <strong>Tips+</strong> to access robust Fabric tooling that helps users create stunning Power BI reports.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          class="rounded-full bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700"
          href="https://marketplace.microsoft.com/en-us/product/carloconsultingllc1611096483318.tips-designer?ocid=tips_site_link&utm_source=account_tips&utm_medium=link&utm_campaign=msft_marketplace"
          target="_blank"
          rel="noopener noreferrer"
        >
          Get Tips+ (Microsoft Marketplace)
        </a>
        <a class="rounded-full bg-neutral-900 px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-800" href={`${base}/microsoft-fabric/`}>Microsoft Fabric</a>
        <a class="rounded-full bg-neutral-100 px-4 py-2 text-sm font-semibold text-neutral-900 hover:bg-neutral-200" href={`${base}/power-bi-apps/`}>Power BI Apps</a>
      </div>
    </div>
  </section>

  <section class="mt-12 grid gap-8 lg:grid-cols-2">
    <div>
      <h2 class="text-2xl font-semibold text-neutral-900">Theme generator posts</h2>
      <div class="mt-4 space-y-3">
        {themePosts.map((p) => (
          <a href={p.href} class="block overflow-hidden rounded-xl border border-neutral-200 hover:shadow-md transition">
            {p.featuredImage ? (
              <div class="aspect-[16/9] w-full bg-neutral-100">
                <Image
                  src={p.featuredImage}
                  alt={p.title}
                  class="h-full w-full object-cover"
                  widths={[400, 800]}
                  sizes="(max-width: 1024px) 100vw, 400px"
                />
              </div>
            ) : null}
            <div class="p-4">
              <div class="text-xs font-semibold uppercase tracking-wide text-neutral-500">{p.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</div>
              <div class="mt-1 font-semibold text-neutral-900">{p.title}</div>
              {p.excerpt ? <div class="mt-2 text-sm text-neutral-600">{p.excerpt}</div> : null}
            </div>
          </a>
        ))}
      </div>
    </div>

    <div>
      <h2 class="text-2xl font-semibold text-neutral-900">Tips+ posts</h2>
      <div class="mt-4 space-y-3">
        {tipsPlusPosts.length ? tipsPlusPosts.map((p) => (
          <a href={p.href} class="block overflow-hidden rounded-xl border border-neutral-200 hover:shadow-md transition">
            {p.featuredImage ? (
              <div class="aspect-[16/9] w-full bg-neutral-100">
                <Image
                  src={p.featuredImage}
                  alt={p.title}
                  class="h-full w-full object-cover"
                  widths={[400, 800]}
                  sizes="(max-width: 1024px) 100vw, 400px"
                />
              </div>
            ) : null}
            <div class="p-4">
              <div class="text-xs font-semibold uppercase tracking-wide text-neutral-500">{p.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</div>
              <div class="mt-1 font-semibold text-neutral-900">{p.title}</div>
              {p.excerpt ? <div class="mt-2 text-sm text-neutral-600">{p.excerpt}</div> : null}
            </div>
          </a>
        )) : <p class="text-neutral-500">No Tips+ matches found yet — we can improve curation.</p>}
      </div>
    </div>
  </section>

  <section class="mt-12 grid gap-8 lg:grid-cols-2">
    <div>
      <h2 class="text-2xl font-semibold text-neutral-900">Free layouts</h2>
      <p class="mt-2 text-neutral-600">Layout patterns and wireframes that help you start strong.</p>
      <div class="mt-4 space-y-3">
        {layoutPosts.map((p) => (
          <a href={p.href} class="block overflow-hidden rounded-xl border border-neutral-200 hover:shadow-md transition">
            {p.featuredImage ? (
              <div class="aspect-[16/9] w-full bg-neutral-100">
                <Image
                  src={p.featuredImage}
                  alt={p.title}
                  class="h-full w-full object-cover"
                  widths={[400, 800]}
                  sizes="(max-width: 1024px) 100vw, 400px"
                />
              </div>
            ) : null}
            <div class="p-4">
              <div class="text-xs font-semibold uppercase tracking-wide text-neutral-500">{p.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</div>
              <div class="mt-1 font-semibold text-neutral-900">{p.title}</div>
              {p.excerpt ? <div class="mt-2 text-sm text-neutral-600">{p.excerpt}</div> : null}
            </div>
          </a>
        ))}
      </div>
    </div>

    <div>
      <h2 class="text-2xl font-semibold text-neutral-900">Free scrims</h2>
      <p class="mt-2 text-neutral-600">Scrims add depth and polish to report backgrounds.</p>
      <div class="mt-4 space-y-3">
        {scrimPosts.map((p) => (
          <a href={p.href} class="block overflow-hidden rounded-xl border border-neutral-200 hover:shadow-md transition">
            {p.featuredImage ? (
              <div class="aspect-[16/9] w-full bg-neutral-100">
                <Image
                  src={p.featuredImage}
                  alt={p.title}
                  class="h-full w-full object-cover"
                  widths={[400, 800]}
                  sizes="(max-width: 1024px) 100vw, 400px"
                />
              </div>
            ) : null}
            <div class="p-4">
              <div class="text-xs font-semibold uppercase tracking-wide text-neutral-500">{p.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</div>
              <div class="mt-1 font-semibold text-neutral-900">{p.title}</div>
              {p.excerpt ? <div class="mt-2 text-sm text-neutral-600">{p.excerpt}</div> : null}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-semibold text-neutral-900">Explore more</h2>
    <div class="mt-4 flex flex-wrap gap-3">
      <a class="rounded-full bg-neutral-100 px-4 py-2 text-sm font-semibold text-neutral-900 hover:bg-neutral-200" href={`${base}/search/?q=theme`}>Search: theme</a>
      <a class="rounded-full bg-neutral-100 px-4 py-2 text-sm font-semibold text-neutral-900 hover:bg-neutral-200" href={`${base}/search/?q=scrim`}>Search: scrim</a>
      <a class="rounded-full bg-neutral-100 px-4 py-2 text-sm font-semibold text-neutral-900 hover:bg-neutral-200" href={`${base}/search/?q=layout`}>Search: layout</a>
    </div>
  </section>
