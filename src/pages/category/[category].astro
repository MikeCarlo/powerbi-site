---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withSiteUtm } from '../../lib/site-utm.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const themeGeneratorCiteHref = `${base}/power-bi-theme-generator/`;
const themeGeneratorToolHref = withSiteUtm('https://themes.powerbi.tips/', 'category-theme-generator');
const layoutsGalleryHref = withSiteUtm(
  'https://tools.powerbi.tips/themes/gallery',
  'category-theme-generator'
);

function slugify(value: string): string {
  return value.toLowerCase().replace(/\s+/g, '-');
}

export async function getStaticPaths() {
  const slugifyCategory = (value: string): string => value.toLowerCase().replace(/\s+/g, '-');
  
  const posts = await getCollection('blog');
  const categories = new Set<string>();

  posts.forEach((post) => {
    post.data.categories?.forEach((category: string) => {
      categories.add(slugifyCategory(category));
    });
  });

  return Array.from(categories).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const posts = (await getCollection('blog'))
  .filter((post) => post.data.categories?.some((cat) => slugify(cat) === category))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    ...post,
    slug: post.id.replace(/\/index\.mdx?$/, '').replace(/\.mdx?$/, '')
  }));

const displayName = posts[0]?.data.categories?.find((cat) => slugify(cat) === category) ?? category;
---

<BaseLayout title={`${displayName} | PowerBI.tips`} description={`Posts in ${displayName}.`}>
  <h1 class="text-3xl font-semibold">{displayName}</h1>
  <p class="mt-2 text-neutral-600">Browse the latest posts tagged in this category.</p>

  {category === 'theme-generator' && (
    <section class="prose mt-8 max-w-none">
      <h2>Start here: What is the Power BI Theme Generator?</h2>
      <p>
        <strong>TL;DR.</strong> Start with the cite page for a plain definition of the free PowerBI.tips
        Theme Generator. Then open the tool to build and download a JSON theme, or browse the layouts
        gallery for page starters.
      </p>
      <ul>
        <li>
          <a href={themeGeneratorCiteHref}>What is the Power BI Theme Generator?</a> (definition / cite)
        </li>
        <li>
          <a href={themeGeneratorToolHref} target="_blank" rel="noopener noreferrer">Open the Theme Generator</a> (create themes)
        </li>
        <li>
          <a href={layoutsGalleryHref} target="_blank" rel="noopener noreferrer">Layouts and theme gallery</a>
        </li>
      </ul>
    </section>
  )}

  <div class="mt-8 grid gap-6 md:grid-cols-2">
    {posts.map((post) => (
      <article class="rounded-xl border border-neutral-200 p-5">
        <p class="text-xs font-semibold uppercase tracking-wide text-neutral-500">
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </p>
        <h2 class="mt-2 text-lg font-semibold">
          <a class="text-blue-600 hover:text-blue-700" href={`${base}/${post.slug}/`}>
            {post.data.title}
          </a>
        </h2>
        {post.data.excerpt && <p class="mt-2 text-sm text-neutral-600">{post.data.excerpt}</p>}
      </article>
    ))}
  </div>
</BaseLayout>

</BaseLayout>
