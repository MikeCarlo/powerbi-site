---
import BaseLayout from '../layouts/BaseLayout.astro';
import { rayfinGames } from '../data/rayfin-games';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Owned H2 + summary + five FAQ H3s (Aero structure, approved by Mike t241u, Nov 27 2026).
// The visible FAQ and the FAQPage JSON-LD render from these same strings.
const hubQuestion = "What is RayFin Games?";
const hubSummary =
  "RayFin Games is six free browser games the PowerBI.tips team built as tests, to see how far we could push Rayfin, the SDK behind Microsoft Fabric Apps. Each one stretches Rayfin in a different direction, from physics and rhythm to your camera and your phone's GPS.";
const hubFaqs: { question: string; answer: string }[] = [
  {
    question: "Why did you build games with Rayfin?",
    answer:
      "To find its limits. Rayfin is meant for data apps on Microsoft Fabric, so we built things it was never designed for, like a physics game, a rhythm game that uses your camera, and a real-world tag game that uses GPS. Each game is a test of how far it could go.",
  },
  {
    question: "Which games are in RayFin Games?",
    answer:
      "Six: Angry Data (physics slingshot), Bit Drop (falling-block puzzle), Data Shuffle (rhythm), Paginated Report Bear (pixel platformer), Squishy Bob (neon platformer) and Hunt Ring (GPS tag battle royale).",
  },
  {
    question: "Are the games free?",
    answer:
      "Yes. All six are free to play in your browser, with nothing to install.",
  },
  {
    question: "Why does Data Shuffle open in a new window?",
    answer:
      "Data Shuffle can use your camera, and browsers block the camera inside an embedded player. The \"Open Groove in new window (camera)\" button opens the game in its own window, where the camera works.",
  },
  {
    question: "How does Hunt Ring work?",
    answer:
      "Hunt Ring is real-world tag for your phone. The ring shrinks, Seekers hunt Runners, and the last Runners standing win. Host a match and have friends scan a QR code to join, or try it with bots.",
  },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: hubFaqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title={"RayFin Games: Free Browser Games Built with Rayfin"}
  description={"Six free browser games we built to test how far Rayfin could go: Angry Data, Bit Drop, Data Shuffle, Paginated Report Bear, Squishy Bob and Hunt Ring."}
  jsonLd={faqJsonLd}
>
  <section class="mb-10">
    <p class="text-sm font-semibold uppercase tracking-wide text-blue-600">Built on Fabric Apps</p>
    <h1 class="mt-1 text-4xl font-semibold tracking-tight text-neutral-900">RayFin Games</h1>
    <p class="mt-3 max-w-3xl text-lg text-neutral-600">
      Games we built with Rayfin and host on Microsoft Fabric Apps. Pick one and it plays right here on PowerBI.tips.
      Curious how they are made? Read about <a class="font-semibold text-blue-600 hover:text-blue-700" href={`${base}/fabric-apps/`}>Fabric Apps</a>.
    </p>
  </section>

  <section aria-label="Games">
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {rayfinGames.map((game) => (
        <li>
          <a
            href={`${base}/rayfin-games/${game.slug}/`}
            class="group block h-full overflow-hidden rounded-2xl border border-neutral-200 bg-white transition hover:-translate-y-1 hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600"
            data-rayfin-tile={game.slug}
          >
            <div class="relative aspect-[16/9] w-full overflow-hidden bg-neutral-900">
              <img
                src={`${base}/images/rayfin-games/${game.slug}.webp`}
                alt={`${game.title} screenshot`}
                width="960"
                height="540"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
              />
              <span class="absolute inset-0 grid place-items-center bg-neutral-900/0 transition group-hover:bg-neutral-900/40">
                <span class="rounded-full bg-white/95 px-5 py-2 text-sm font-semibold text-neutral-900 opacity-0 shadow transition group-hover:opacity-100">▶ Play</span>
              </span>
            </div>
            <div class="p-5">
              <div class="text-xs font-semibold uppercase tracking-wide text-neutral-500">{game.genre}</div>
              <h2 class="mt-1 text-xl font-semibold text-neutral-900">{game.title}</h2>
              <p class="mt-2 text-sm text-neutral-600">{game.description}</p>
              <div class="mt-3 text-sm font-semibold text-blue-600">Play now →</div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-12 mb-12 prose max-w-none" aria-labelledby="what-is-rayfin-games">
    <h2 id="what-is-rayfin-games">{hubQuestion}</h2>
    <p>{hubSummary}</p>
    {hubFaqs.map((item) => (
      <>
        <h3>{item.question}</h3>
        <p>{item.answer}</p>
      </>
    ))}
  </section>
</BaseLayout>
